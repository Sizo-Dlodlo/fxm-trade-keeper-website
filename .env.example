# Database
DATABASE_URL="postgresql://user:password@localhost:5432/fxm_website"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-random-secret-here"

# Admin credentials (used by seed script)
ADMIN_EMAIL="admin@fxmtradekeeper.com"
ADMIN_PASSWORD="change-this-password"

# Web App (PWA) install URL — the app.<your-domain> subdomain hosting the PWA.
# Prefix MUST be NEXT_PUBLIC_ so it is available in the browser.
NEXT_PUBLIC_APP_URL="https://app.fxmtradekeeper.com"

# Google Analytics 4 (leave blank to disable).
# Add your Measurement ID from analytics.google.com, e.g. G-ABC123XYZ.
# Prefix MUST be NEXT_PUBLIC_ so it is available in the browser.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google AdSense (leave blank until your account is APPROVED).
# ADSENSE_CLIENT_ID = your pub-XXXXXXXX number shown in AdSense.
# ADSENSE_VERIFICATION = the content value Google gives you for site verification
# (found in AdSense > Settings > Account > "Click here to verify your site").
# Both must be set for ads to load; omit/blank to keep AdSense fully off.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADSENSE_VERIFICATION=""

# Donations / support links
PAYPAL_DONATE_URL="https://www.paypal.me/captainpricee"
BUYMEACOFFEE_URL="https://buymeacoffee.com/sizodlod"

# Email (Contact/Newsletter)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Storage (Release files)
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET=""
